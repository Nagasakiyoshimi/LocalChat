{
  "name": "localchat",
  "productName": "LocalChat",
  "version": "1.1.1",
  "description": "Serverless LAN chat rooms and file sharing, like LocalSend with chat.",
  "author": "Nagasakiyoshimi",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "start:second": "LOCALCHAT_PROFILE=2 electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.localchat.app",
    "productName": "LocalChat",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": "nsis",
      "artifactName": "LocalChat-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
